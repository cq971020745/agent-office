{
  "name": "agent-office",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @office/server dev",
    "dev:desktop": "pnpm --filter @office/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @office/server test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}
