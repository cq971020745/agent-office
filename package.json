{
  "name": "agent-office",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev:server": "pnpm --filter @office/server dev",
    "dev:desktop": "pnpm --filter @office/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @office/server test",
    "stage:server": "node scripts/stage-server.mjs",
    "pack:desktop": "node scripts/pack-desktop.mjs",
    "pack:win": "node scripts/pack-desktop.mjs --win",
    "pack:mac": "node scripts/pack-desktop.mjs --mac",
    "pack:linux": "node scripts/pack-desktop.mjs --linux"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "electron",
      "electron-winstaller",
      "sherpa-onnx-node",
      "@napi-rs/canvas"
    ],
    "ignoredBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  },
  "devDependencies": {
    "tar": "7.5.22"
  }
}
